# ================================
# Anwar TalentFlow Environment Variables
# ================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ---- Application ----
NODE_ENV=development
APP_PORT=3001
APP_NAME=TalentFlow
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
API_PREFIX=api
API_VERSION=v1

# ---- Database (PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=talentflow
DB_PASSWORD=talentflow_dev_password
DB_DATABASE=talentflow_dev
DB_SSL=false
DB_SYNCHRONIZE=false
DB_LOGGING=true

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- JWT / Auth ----
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_use_openssl_rand_base64_64
JWT_ACCESS_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d
BCRYPT_ROUNDS=12

# ---- File Storage (S3 Compatible) ----
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=talentflow-documents
STORAGE_REGION=us-east-1
STORAGE_SIGNED_URL_EXPIRY=900

# ---- Email (SMTP) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=TalentFlow
SMTP_FROM_EMAIL=noreply@talentflow.anwargroup.com

# ---- WhatsApp (Stub for MVP) ----
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---- Rate Limiting ----
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL=900000
AUTH_THROTTLE_LIMIT=5

# ---- File Upload ----
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/jpeg,image/png

# ---- Session ----
SESSION_MAX_CONCURRENT=5

# ---- Data Retention ----
DATA_RETENTION_DAYS=730
